      "say": [
        {
          "lang": "de",
          "text": "Hör zu: Mateo hat ein Problem.",
          "es": "Escucha: Mateo tiene un problema.",
          "en": "Listen: Mateo has a problem."
        },
        {
          "lang": "de",
          "text": "Kannst du mir helfen?",
          "es": "¿Me puedes ayudar?",
          "en": "Can you help me?",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Klar! Was ist los?",
          "es": "¡Claro! ¿Qué pasa?",
          "en": "Sure! What's up?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Der Drucker geht nicht.",
          "es": "La impresora no funciona.",
          "en": "The printer isn't working.",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Warte, ich helfe dir.",
          "es": "Espera, te ayudo.",
          "en": "Wait, I'll help you.",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "So, er geht wieder!",
          "es": "Listo, ¡ya funciona!",
          "en": "There, it works again!",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Danke! Ich lade dich zum Kaffee ein.",
          "es": "¡Gracias! Te invito a un café.",
          "en": "Thanks! I'll buy you a coffee.",
          "voice": "m"
        }
