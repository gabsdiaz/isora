      ],
      "say": [
        {
          "lang": "de",
          "text": "Bei helfen sagst du mir und dir:",
          "es": "Con helfen dices mir y dir:",
          "en": "With helfen you say mir and dir:"
        },
        {
          "lang": "de",
          "text": "Kannst du mir helfen?",
          "es": "¿Me puedes ayudar?",
          "en": "Can you help me?",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Und höflich, mit Sie:",
          "es": "Y con cortesía, con Sie:",
          "en": "And politely, with Sie:"
        },
        {
          "lang": "de",
          "text": "Kann ich Ihnen helfen?",
          "es": "¿Le puedo ayudar?",
          "en": "Can I help you?",
          "voice": "f"
        }
      ]
    },
