      "say": [
        {
          "lang": "de",
          "text": "Nach vielen Verben brauchst du den Akkusativ. Zum Beispiel: Ruf mich an!",
          "es": "Después de muchos verbos necesitas el acusativo. Por ejemplo: ¡llámame!",
          "en": "Many verbs need the accusative. For example: call me!"
        },
        {
          "lang": "de",
          "text": "ich wird mich",
          "es": "ich se vuelve mich (me)",
          "en": "ich becomes mich (me)"
        },
        {
          "lang": "de",
          "text": "du wird dich",
          "es": "du se vuelve dich (te)",
          "en": "du becomes dich (you)"
        },
        {
          "lang": "de",
          "text": "er wird ihn",
          "es": "er se vuelve ihn (lo)",
          "en": "er becomes ihn (him)"
        },
        {
          "lang": "de",
          "text": "sie bleibt sie",
          "es": "sie se queda sie (la)",
          "en": "sie stays sie (her)"
        },
        {
          "lang": "de",
          "text": "und Sie bleibt Sie.",
          "es": "y Sie se queda Sie (lo, la, usted).",
          "en": "and Sie stays Sie."
        }
