          "en": "You hear these words at the practice:"
        },
        {
          "lang": "de",
          "text": "Ich habe Fieber.",
          "es": "Tengo fiebre.",
          "en": "I have a fever."
        },
        {
          "lang": "de",
          "text": "Ich habe Husten.",
          "es": "Tengo tos.",
          "en": "I have a cough."
        },
        {
          "lang": "de",
          "text": "Ich habe Schnupfen.",
          "es": "Tengo gripa.",
          "en": "I have a cold."
        },
        {
          "lang": "de",
          "text": "Nehmen Sie die Tabletten.",
          "es": "Tome las pastillas.",
          "en": "Take the tablets."
        },
        {
          "lang": "de",
          "text": "Hier ist das Rezept.",
          "es": "Aquí está la fórmula.",
          "en": "Here's the prescription."
