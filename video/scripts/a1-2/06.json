      ],
      "say": [
        {
          "lang": "de",
          "text": "Der Arzt fragt: Seit wann sind Sie krank? Du antwortest mit seit:",
          "es": "El médico pregunta: ¿desde cuándo está enfermo? Respondes con seit:",
          "en": "The doctor asks: since when have you been ill? You answer with seit:"
        },
        {
          "lang": "de",
          "text": "Seit drei Tagen.",
          "es": "Desde hace tres días.",
          "en": "For three days.",
          "voice": "m"
