          "en": "Listen: it's Monday. Lena asks Mateo."
        },
        {
          "lang": "de",
          "text": "Was hast du am Wochenende gemacht?",
          "es": "¿Qué hiciste?",
          "en": "What did you do?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Ich habe Fußball gespielt.",
          "es": "Jugué fútbol.",
          "en": "I played football.",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Und ich habe gekocht.",
          "es": "Y cociné.",
          "en": "And I cooked.",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Was hast du gekocht?",
          "es": "¿Qué cocinaste?",
          "en": "What did you cook?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Eine Suppe. Und du?",
          "es": "Una sopa. ¿Y tú?",
          "en": "A soup. And you?",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Ich habe viel gelesen.",
          "es": "Leí mucho.",
          "en": "I read a lot.",
          "voice": "f"
        }
