        },
        {
          "lang": "de",
          "text": "Ich habe bald Geburtstag!",
          "es": "¡Pronto es mi cumpleaños!",
          "en": "It's my birthday soon!",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Wann denn?",
          "es": "¿Y cuándo?",
          "en": "When?",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Am zwölften Mai.",
          "es": "El doce de mayo.",
          "en": "On the twelfth of May.",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Kommst du zu meiner Party?",
          "es": "¿Vienes a mi fiesta?",
          "en": "Will you come to my party?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Gern! Was soll ich mitbringen?",
          "es": "¡Con gusto! ¿Qué llevo?",
          "en": "Gladly! What should I bring?",
          "voice": "m"
