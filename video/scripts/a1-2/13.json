        {
          "lang": "de",
          "text": "Diese Feste gibt es in Deutschland. Und das sagst du:",
          "es": "Estas fiestas hay en Alemania. Y esto dices:",
          "en": "These are celebrations in Germany. And this is what you say:"
        },
        {
          "lang": "de",
          "text": "Alles Gute zum Geburtstag!",
          "es": "¡Feliz cumpleaños!",
          "en": "Happy birthday!"
        },
        {
          "lang": "de",
          "text": "Frohe Weihnachten!",
          "es": "¡Feliz Navidad!",
          "en": "Merry Christmas!"
        },
        {
          "lang": "de",
          "text": "Frohes neues Jahr!",
          "es": "¡Feliz año nuevo!",
          "en": "Happy New Year!"
        },
        {
          "lang": "de",
          "text": "Frohe Ostern!",
          "es": "¡Felices Pascuas!",
          "en": "Happy Easter!"
        },
        {
          "lang": "de",
          "text": "Herzlichen Glückwunsch!",
          "es": "¡Felicitaciones!",
          "en": "Congratulations!"
        }
