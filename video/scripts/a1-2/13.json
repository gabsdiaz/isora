      "say": [
        {
          "lang": "de",
          "text": "Für das Datum brauchst du Ordinalzahlen. Zwei sind besonders:",
          "es": "Para la fecha necesitas números ordinales. Dos son especiales:",
          "en": "For dates you need ordinal numbers. Two are special:"
        },
        {
          "lang": "de",
          "text": "der erste",
          "es": "el primero",
          "en": "the first"
        },
        {
          "lang": "de",
          "text": "der dritte",
          "es": "el tercero",
          "en": "the third"
        },
        {
          "lang": "de",
          "text": "Sonst bis neunzehn: plus te. Der vierte.",
          "es": "Si no, hasta diecinueve: más te. Der vierte (el cuarto).",
          "en": "Otherwise up to nineteen: add te. Der vierte."
        },
        {
          "lang": "de",
          "text": "Ab zwanzig: plus ste. Der zwanzigste.",
          "es": "Desde veinte: más ste. Der zwanzigste (el vigésimo).",
          "en": "From twenty: add ste. Der zwanzigste."
        }
      ],
