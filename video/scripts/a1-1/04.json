        },
        {
          "lang": "de",
          "text": "Nicht so gut.",
          "es": "No muy bien.",
          "en": "Not so good.",
          "voice": "m"
        },
        {
          "lang": "de",
          "text": "Und dann fragst du: Und dir?",
          "es": "Y luego preguntas: ¿Y tú?",
          "en": "And then you ask: And you?"
