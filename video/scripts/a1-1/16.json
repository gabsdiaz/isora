      "lines": [
        {
          "de": "Wo finde ich Reis?",
          "es": "¿Dónde encuentro arroz?",
          "mark": "Wo finde ich",
          "at": 1
        },
        {
          "de": "Haben Sie Erdbeeren?",
          "es": "¿Tiene fresas?",
          "mark": "Haben Sie",
          "at": 3
        }
      ],
      "say": [
        {
          "lang": "de",
          "text": "Du suchst etwas? Dann fragst du:",
          "es": "¿Buscas algo? Entonces preguntas:",
          "en": "Looking for something? Then you ask:"
        },
        {
          "lang": "de",
          "text": "Entschuldigung, wo finde ich Reis?",
          "es": "Disculpe, ¿dónde encuentro arroz?",
          "en": "Excuse me, where can I find rice?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Oder du fragst:",
          "es": "O preguntas:",
          "en": "Or you ask:"
        },
        {
          "lang": "de",
          "text": "Haben Sie frische Erdbeeren?",
          "es": "¿Tiene fresas frescas?",
          "en": "Do you have fresh strawberries?",
          "voice": "f"
        },
        {
          "lang": "de",
          "text": "Sag zuerst Entschuldigung. Das ist höflich.",
          "es": "Di primero Entschuldigung (disculpe). Es cortés.",
          "en": "Say Entschuldigung (excuse me) first. That's polite."
        }
      ]
    },
